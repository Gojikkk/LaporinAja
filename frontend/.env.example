VITE_API_URL=http://localhost:3000/api
# Readable CSRF cookie issued by the API (never the session cookie)
VITE_CSRF_COOKIE_NAME=laporinaja_csrf
# CSRF request header name expected by the API
VITE_CSRF_HEADER_NAME=X-CSRF-Token
# Optional: endpoint that returns a CSRF token when the readable cookie is absent
VITE_CSRF_ENDPOINT=/auth/csrf
# Optional: Google Identity Services client ID to enable "Masuk dengan Google"
VITE_GOOGLE_CLIENT_ID=
