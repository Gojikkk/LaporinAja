VITE_API_URL=http://localhost:3000/api
# Optional: name of a readable CSRF cookie issued by the API (never the session cookie)
VITE_CSRF_COOKIE_NAME=
# Optional: CSRF request header name expected by the API
VITE_CSRF_HEADER_NAME=X-CSRF-Token
# Required when the frontend and API are on separate origins
VITE_CSRF_ENDPOINT=
